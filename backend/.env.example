# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Optional - search works in-memory without MongoDB if not running)
MONGODB_URI=mongodb://localhost:27017/a-una-milla

# Flight Provider Selection ('amadeus' or 'mock')
FLIGHT_PROVIDER=amadeus

# Amadeus Self-Service API Credentials
# Get free test credentials at https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Award Inventory Provider (Optional - Phase 6)
# If left blank, award search explicitly returns status: 'unsupported'
SEATS_AERO_API_KEY=

# Rate Limiting & Performance
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
CACHE_TTL_SECONDS=900
