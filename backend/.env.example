# Server Configuration
PORT=5001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173

# Database (Supabase PostgreSQL via Drizzle ORM and pg)
# Direct connection (port 5432, requires IPv6 support in host environment):
# DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
# Connection Pooler (port 6543 / 5432 session, works over IPv4 without add-ons):
# DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true
DATABASE_URL=

# Flight Provider Selection ('amadeus' or 'mock')
FLIGHT_PROVIDER=amadeus

# Amadeus Self-Service API Credentials
# Get free test credentials at https://developers.amadeus.com/
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=
AMADEUS_ENV=test

# Award Inventory Provider (Optional - Phase 6)
# If left blank, award search explicitly returns status: 'unsupported'
SEATS_AERO_API_KEY=

# Rate Limiting & Performance
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=60
CACHE_TTL_SECONDS=900

# Authentication & Session Security (Phase 10)
JWT_SECRET=your-random-32-character-secret-key-change-in-production
